# Supervisor settings for the host. Copy to /etc/qte/ops.env (Linux) or deploy/ops.env
# (Windows); both are kept out of git. No secrets beyond the ntfy topic go here: the team
# token lives in its own file (QTE_TOKEN_FILE), written by `python -m qte_sdk.token set --file`.

# Exchange address, and where the SDK finds the team token.
QTE_URL=wss://REPLACE-WITH-THE-EXCHANGE-ADDRESS/ws
QTE_TOKEN_FILE=/opt/qte/.qte/token

# Strategy IDs registered by the Team Lead for this term (Rule 1002). Each term needs new ones.
QTE_QUOTER_ID=sf_print_capture_v1
QTE_HEDGER_ID=sf_delta_hedger_v1
QTE_PICKER_ID=sf_stale_picker_v1

# Push alerts: subscribe to this topic in the ntfy app on every supervisor's phone. Anyone who
# knows the name can read and post to it, so make it long and random, e.g.
#   python -c "import secrets; print('qte-sf-' + secrets.token_urlsafe(18))"
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=            # only for a private or self-hosted ntfy server

# Dead-man heartbeat: a URL pinged every minute (a free healthchecks.io check, period 1 min,
# grace 3 min, alerting to ntfy or email). It catches what the supervisor cannot report
# itself: the host down, out of memory, or the network gone.
HEARTBEAT_URL=

# 1 runs every bot with --dry-run: they read the market and send nothing. Start with 1.
QTE_DRY_RUN=1
