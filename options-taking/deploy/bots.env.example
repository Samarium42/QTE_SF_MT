# Copy to /etc/qte/bots.env (mode 600) and fill in. Read by the systemd units.
# Strategy IDs must be registered by the Team Lead for the current term (Rule 1002).
QUOTER_STRAT_ID=sf_print_capture_v2
HEDGER_STRAT_ID=sf_delta_hedger_v2
PICKER_STRAT_ID=sf_stale_picker_v2
# Extra flags. With the hedger running, the quoter must not hedge too.
QUOTER_FLAGS=--no-hedge
HEDGER_FLAGS=
PICKER_FLAGS=
PAPER_FLAGS=--no-hedge
# Alerts: a Discord or Slack incoming-webhook URL (keep it secret), or leave empty.
QTE_ALERT_WEBHOOK=
